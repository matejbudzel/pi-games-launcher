[Unit]
Description=pi-games-launcher on tty1
After=systemd-user-sessions.service
Conflicts=getty@tty1.service
Before=getty@tty1.service
[Service]
Type=simple
User=@USER@
ExecStartPre=+/sbin/modprobe bcm2835-codec
ExecStartPre=+/sbin/modprobe snd_bcm2835
WorkingDirectory=@REPO@
Environment=HOME=@HOME@
Environment=TERM=linux
# Every provider guest inherits the proven SDL 1.2 fbcon workaround from the
# appliance owner.  Individual providers must not configure framebuffer modes.
Environment=SDL_FB_BROKEN_MODES=1
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
ExecStart=/usr/bin/python3 -m launcher.main --config @REPO@/config/launcher.conf
Restart=on-failure
RestartSec=2
SuccessExitStatus=42
# Only Ctrl-C's maintenance exit releases tty1 to its normal login getty.
ExecStopPost=+/bin/sh -c '[ "$EXIT_STATUS" = 42 ] && /usr/bin/systemctl --no-block start getty@tty1.service || true'
[Install]
WantedBy=multi-user.target
